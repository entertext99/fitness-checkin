.measure-page { padding-bottom: 20px; }

.measure-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 12px;
}

.measure-field {
  display: flex;
  align-items: center;
  background: #F9F9F9;
  border-radius: 8px;
  padding: 8px 12px;
  border: 1px solid #EEEEEE;
}

.measure-lbl {
  font-size: 13px;
  color: #666666;
  min-width: 48px;
}

.measure-inp {
  flex: 1;
  height: 32px;
  text-align: right;
  font-size: 14px;
  color: #333333;
  background: transparent;
}

.measure-save {
  width: 100%;
}

.chart-canvas {
  width: 100%;
  height: 180px;
  margin-top: 8px;
}

.empty-hint {
  text-align: center;
  padding: 24px 0;
  font-size: 13px;
  color: #CCCCCC;
}

.measure-list { margin-top: 4px; }

.measure-record {
  display: flex;
  align-items: flex-start;
  padding: 10px 0;
  border-bottom: 1px solid #F5F5F5;
}

.measure-record:last-child { border-bottom: none; }

.measure-rec-date {
  font-size: 12px;
  color: #999999;
  min-width: 80px;
  margin-top: 2px;
}

.measure-rec-vals {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  flex: 1;
}

.measure-rec-tag {
  font-size: 11px;
  color: #666666;
  background: #F5F5F5;
  padding: 3px 10px;
  border-radius: 10px;
}
