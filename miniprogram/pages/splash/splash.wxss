.splash-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: linear-gradient(180deg, #FFB5C2 0%, #FFD6DE 40%, #FFF5F6 100%);
  overflow: hidden;
}

.splash-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeInUp 1s ease-out;
}

.splash-icon {
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(255, 138, 155, 0.2);
}

.icon-text {
  font-size: 80rpx;
}

.splash-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 10rpx rgba(255, 138, 155, 0.3);
  margin-bottom: 20rpx;
  text-align: center;
}

.splash-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 40rpx;
}

.splash-decoration {
  display: flex;
  gap: 20rpx;
}

.deco-item {
  font-size: 40rpx;
  animation: float 2s ease-in-out infinite;
}

.deco-item:nth-child(2) {
  animation-delay: 0.5s;
}

.deco-item:nth-child(3) {
  animation-delay: 1s;
}

.splash-footer {
  position: absolute;
  bottom: 100rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  font-size: 60rpx;
  color: rgba(255, 255, 255, 0.6);
  animation: bounce 1.4s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes bounce {
  0%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-15rpx); }
}
