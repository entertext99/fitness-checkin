<view class="diet-page">
  <view class="diet-card card">
    <view class="diet-month-nav">
      <text class="diet-nav-btn" bindtap="prevMonth">‹</text>
      <text class="diet-month-title">{{year}}年{{month}}月</text>
      <text class="diet-nav-btn" bindtap="nextMonth">›</text>
    </view>
    <view class="diet-weekday-row">
      <text class="diet-weekday" wx:for="{{weekdays}}" wx:key="index">{{item}}</text>
    </view>
    <view class="diet-days-grid">
      <view class="diet-day-empty" wx:for="{{emptyCells}}" wx:key="index"></view>
      <view class="diet-day-cell {{item.isToday ? 'diet-today' : ''}} {{item.status === 'healthy' ? 'diet-healthy' : ''}} {{item.status === 'high_calorie' ? 'diet-junk' : ''}}"
            wx:for="{{days}}" wx:key="index"
            data-date="{{item.date}}" bindtap="onDayTap">
        <text class="diet-day-num {{item.status ? 'diet-day-num-recorded' : ''}} {{item.isToday && !item.status ? 'diet-today-num' : ''}}">{{item.day}}</text>
      </view>
    </view>
  </view>

  <!-- Quick Mark -->
  <view class="diet-select-card card">
    <text class="section-title">🥗 饮食记录</text>
    <text class="current-date-label">{{displayDate}}</text>
    <view class="diet-select-row">
      <button class="diet-btn diet-btn-healthy" bindtap="chooseHealthy">🥗 健康饮食</button>
      <button class="diet-btn diet-btn-junk" bindtap="chooseJunk">🍔 高热量饮食</button>
    </view>
    <view wx:if="{{todayStatus && items.length === 0}}" class="diet-today-tip">
      <text>已标记：{{todayStatus === 'healthy' ? '健康饮食 🥗' : '高热量饮食 🍔'}}</text>
    </view>
    <view wx:if="{{items.length > 0}}" class="diet-today-tip">
      <text>{{todayStatus === 'healthy' ? '🥗 健康饮食' : '⚠️ 高热量饮食'}} · {{items.length}}条食物 · 共{{totalCalories}}千卡</text>
    </view>
  </view>

  <!-- Calorie Summary -->
  <view wx:if="{{bmr > 0}}" class="card">
    <text class="section-title">📊 热量汇总</text>
    <view class="cal-summary-bar">
      <view class="cal-bar-bg">
        <view wx:if="{{redPct > 0}}" class="cal-bar-fill cal-bar-over" style="width:{{redPct}}%"></view>
        <view wx:if="{{greenPct > 0}}" class="cal-bar-fill cal-bar-ok" style="width:{{greenPct}}%"></view>
      </view>
      <view class="cal-bar-labels">
        <text class="cal-bar-total">已摄入 {{totalCalories}} 千卡</text>
        <text class="cal-bar-bmr">基础代谢 {{bmr}} 千卡</text>
      </view>
    </view>
    <view wx:if="{{totalCalories > 0}}" class="cal-summary-text">
      <text wx:if="{{totalCalories <= bmr}}">✅ 今日还可摄入 {{bmr - totalCalories}} 千卡</text>
      <text wx:else>⚠️ 已超过基础代谢 {{totalCalories - bmr}} 千卡</text>
    </view>
  </view>

  <!-- Add Food (Text Only) -->
  <view class="card">
    <view class="detail-header" bindtap="toggleDetail">
      <text class="section-title" style="margin-bottom:0">📝 添加食物</text>
      <text class="detail-toggle">{{showDetail ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
  </view>

  <view wx:if="{{showDetail}}" class="card">
    <input class="diet-text-input" placeholder="食物名称（如：米饭）" value="{{foodName}}" bindinput="onFoodNameInput" />
    <view class="diet-cal-input-row">
      <input class="diet-cal-input" type="digit" placeholder="热量（千卡）" value="{{foodCalories}}" bindinput="onFoodCaloriesInput" />
      <text class="diet-cal-unit">千卡</text>
    </view>
    <button class="diet-add-btn" bindtap="addFoodItem">＋ 添加食物</button>
  </view>

  <!-- Food List -->
  <view wx:if="{{items.length > 0}}" class="card">
    <text class="section-title">🍽️ 食物记录 ({{items.length}})</text>
    <view class="food-item" wx:for="{{items}}" wx:for-index="idx" wx:key="createTime">
      <view class="food-num">{{idx + 1}}</view>
      <view class="food-info">
        <text class="food-name">{{item.foodName}}</text>
        <text class="food-cal">{{item.calories}}千卡</text>
      </view>
      <text class="food-del" data-index="{{idx}}" bindtap="deleteFoodItem">✕</text>
    </view>
  </view>

  <view class="diet-legend-card card">
    <view class="diet-legend-row">
      <view class="diet-legend-item">
        <view class="diet-legend-dot diet-legend-green"></view>
        <text class="diet-legend-text">健康饮食</text>
      </view>
      <view class="diet-legend-item">
        <view class="diet-legend-dot diet-legend-red"></view>
        <text class="diet-legend-text">高热量饮食</text>
      </view>
    </view>
  </view>

  <view class="card history-nav-card" bindtap="goCalendar">
    <text class="history-nav-icon">📋</text>
    <text class="history-nav-text">查看历史记录</text>
    <text class="history-nav-arrow">›</text>
  </view>

  <view wx:if="{{showModal}}" class="diet-overlay" catchtouchmove bindtap="closeModal">
    <view class="diet-result-panel {{modalType === 'warn' ? 'panel-warn' : 'panel-keep'}}" catchtap>
      <text class="diet-result-icon">{{modalIcon}}</text>
      <text class="diet-result-text">{{modalText}}</text>
      <button class="diet-result-btn" bindtap="closeModal">确认</button>
    </view>
  </view>
</view>
