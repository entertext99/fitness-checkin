<view class="diet-page">
  <view class="diet-card card">
    <view class="diet-month-nav">
      <text class="diet-nav-btn" bindtap="prevMonth">‹</text>
      <text class="diet-month-title">{{year}}年{{month}}月</text>
      <text class="diet-nav-btn" bindtap="nextMonth">›</text>
    </view>
    <view class="diet-weekday-row">
      <text class="diet-weekday" wx:for="{{weekdays}}" wx:key="index">{{item}}</text>
    </view>
    <view class="diet-days-grid">
      <view class="diet-day-empty" wx:for="{{emptyCells}}" wx:key="index"></view>
      <view class="diet-day-cell {{item.isToday ? 'diet-today' : ''}} {{item.status === 'healthy' ? 'diet-healthy' : ''}} {{item.status === 'high_calorie' ? 'diet-junk' : ''}}"
            wx:for="{{days}}" wx:key="index"
            data-date="{{item.date}}"
            bindtap="onDayTap">
        <text class="diet-day-num {{item.status ? 'diet-day-num-recorded' : ''}} {{item.isToday && !item.status ? 'diet-today-num' : ''}}">{{item.day}}</text>
      </view>
    </view>
  </view>

  <view class="diet-select-card card">
    <text class="section-title">今日饮食</text>
    <view class="diet-select-row">
      <button class="diet-btn diet-btn-healthy" bindtap="chooseHealthy">🥗 健康饮食</button>
      <button class="diet-btn diet-btn-junk" bindtap="chooseJunk">🍔 高热量饮食</button>
    </view>
    <view wx:if="{{todayStatus}}" class="diet-today-tip">
      <text>今日已记录：{{todayStatus === 'healthy' ? '健康饮食 🥗' : '高热量饮食 🍔'}}，再次点击可更新</text>
    </view>
  </view>

  <view class="diet-legend-card card">
    <view class="diet-legend-row">
      <view class="diet-legend-item">
        <view class="diet-legend-dot diet-legend-green"></view>
        <text class="diet-legend-text">健康饮食</text>
      </view>
      <view class="diet-legend-item">
        <view class="diet-legend-dot diet-legend-red"></view>
        <text class="diet-legend-text">高热量饮食</text>
      </view>
    </view>
  </view>

  <view class="card history-nav-card" bindtap="goCalendar">
    <text class="history-nav-icon">📋</text>
    <text class="history-nav-text">查看历史记录</text>
    <text class="history-nav-arrow">›</text>
  </view>

  <view wx:if="{{showModal}}" class="diet-overlay" catchtouchmove bindtap="closeModal">
    <view class="diet-result-panel {{modalType === 'warn' ? 'panel-warn' : 'panel-keep'}}" catchtap>
      <text class="diet-result-icon">{{modalIcon}}</text>
      <text class="diet-result-text">{{modalText}}</text>
      <button class="diet-result-btn" bindtap="closeModal">确认</button>
    </view>
  </view>
</view>
