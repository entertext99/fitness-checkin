<view class="profile-page">
  <view class="profile-header card">
    <view class="avatar-circle"><text class="avatar-text">💪</text></view>
    <text class="profile-name">{{nickname || '健身达人'}}</text>
  </view>

  <view class="card">
    <view class="card-title-row">
      <text class="section-title">📋 个人信息</text>
      <button wx:if="{{!editing}}" class="btn-edit" bindtap="toggleEdit">修改信息</button>
      <view wx:if="{{editing}}" class="edit-actions">
        <button class="btn-cancel" bindtap="cancelEdit">取消</button>
        <button class="btn-save" bindtap="saveProfile">保存</button>
      </view>
    </view>

    <view wx:if="{{!editing}}" class="info-display">
      <view class="info-row"><text class="info-lbl">昵称</text><text class="info-val">{{nickname || '未设置'}}</text></view>
      <view class="info-row"><text class="info-lbl">性别</text><text class="info-val">{{gender || '未设置'}}</text></view>
      <view class="info-row"><text class="info-lbl">生日</text><text class="info-val">{{birthday || '未设置'}}</text></view>
      <view class="info-row"><text class="info-lbl">身高</text><text class="info-val">{{height ? height + ' cm' : '未设置'}}</text></view>
      <view class="info-row"><text class="info-lbl">初始体重</text><text class="info-val">{{initWeight ? initWeight + ' kg' : '未设置'}}</text></view>
      <view class="info-row"><text class="info-lbl">当前体重</text><text class="info-val info-val-pink">{{currentWeight ? currentWeight + ' kg' : '暂无数据'}}</text><text wx:if="{{currentWeight}}" class="auto-tag">自动同步</text></view>
    </view>

    <view wx:if="{{editing}}" class="info-edit">
      <view class="profile-field">
        <text class="profile-lbl">昵称</text>
        <input class="profile-inp" placeholder="输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
      </view>
      <view class="profile-field">
        <text class="profile-lbl">性别</text>
        <picker range="{{['男','女']}}" value="{{gender === '女' ? 1 : 0}}" bindchange="onGenderChange">
          <text class="profile-val">{{gender || '选择性别'}}</text>
        </picker>
      </view>
      <view class="profile-field">
        <text class="profile-lbl">生日</text>
        <picker mode="date" value="{{birthday}}" bindchange="onBirthdayChange">
          <text class="profile-val">{{birthday || '选择日期'}}</text>
        </picker>
      </view>
      <view class="profile-field">
        <text class="profile-lbl">身高(cm)</text>
        <input class="profile-inp" type="digit" placeholder="输入身高" value="{{height}}" bindinput="onHeightInput" />
      </view>
      <view class="profile-field">
        <text class="profile-lbl">初始体重(kg)</text>
        <input class="profile-inp" type="digit" placeholder="输入初始体重" value="{{initWeight}}" bindinput="onInitWeightInput" />
      </view>
      <view class="profile-field">
        <text class="profile-lbl">当前体重(kg)</text>
        <input class="profile-inp" type="digit" placeholder="输入当前体重" value="{{currentWeight}}" bindinput="onCurrentWeightInput" />
      </view>
    </view>

    <view wx:if="{{bmi}}" class="bmi-section">
      <view class="bmi-row"><text class="bmi-label">BMI指数：</text><text class="bmi-value">{{bmi}}</text></view>
      <view class="bmi-row"><text class="bmi-label">当前体型：</text><text class="bmi-type {{bodyType === '偏瘦' ? 'type-thin' : ''}} {{bodyType === '标准' ? 'type-normal' : ''}} {{bodyType === '超重' ? 'type-over' : ''}} {{bodyType === '肥胖' ? 'type-fat' : ''}}">{{bodyType}}</text></view>

      <view class="bmi-bar-wrap">
        <view class="bmi-bar">
          <view class="bmi-bar-seg bmi-bar-thin" style="width:28.3%"></view>
          <view class="bmi-bar-seg bmi-bar-normal" style="width:21.7%"></view>
          <view class="bmi-bar-seg bmi-bar-over" style="width:16.7%"></view>
          <view class="bmi-bar-seg bmi-bar-fat" style="width:33.3%"></view>
        </view>
        <view class="bmi-bar-labels">
          <text class="bmi-bar-lbl" style="left:0%">偏瘦</text>
          <text class="bmi-bar-lbl" style="left:28.3%">标准</text>
          <text class="bmi-bar-lbl" style="left:50%">超重</text>
          <text class="bmi-bar-lbl" style="left:66.7%">肥胖</text>
        </view>
        <view class="bmi-bar-ranges">
          <text class="bmi-bar-range" style="left:28.3%">18.5</text>
          <text class="bmi-bar-range" style="left:50%">25</text>
          <text class="bmi-bar-range" style="left:66.7%">30</text>
          <text class="bmi-bar-range" style="right:0;transform:translateX(50%)">40</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="section-title">📊 打卡统计</text>
    <view class="stats-row">
      <view class="stats-box"><text class="stats-num">{{stats.continuousDays}}</text><text class="stats-label">连续打卡</text></view>
      <view class="stats-box"><text class="stats-num">{{stats.totalCheckins}}</text><text class="stats-label">总打卡</text></view>
      <view class="stats-box"><text class="stats-num">{{stats.totalHours}}</text><text class="stats-label">总时长(时)</text></view>
    </view>
  </view>
</view>