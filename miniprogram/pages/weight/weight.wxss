.weight-page { padding-bottom: 20px; }

.weight-input-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.weight-input {
  flex: 1;
  height: 40px;
  background: #F9F9F9;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 14px;
  color: #333333;
  border: 1px solid #EEEEEE;
}

.weight-unit {
  font-size: 14px;
  color: #999999;
  font-weight: 500;
}

.weight-save {
  flex-shrink: 0;
}

.chart-canvas {
  width: 100%;
  height: 180px;
  margin-top: 8px;
}

.empty-hint {
  text-align: center;
  padding: 24px 0;
  font-size: 13px;
  color: #CCCCCC;
}

