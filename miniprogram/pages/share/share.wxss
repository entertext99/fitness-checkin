.share-page { padding-bottom: 20px; }

.room-desc {
  display: block;
  font-size: 13px;
  color: #999999;
  margin-bottom: 14px;
  text-align: center;
}

.room-join-btn {
  flex-shrink: 0;
  width: auto;
  height: 44px;
  line-height: 44px;
  padding: 0 20px;
}

.room-join-row {
  display: flex;
  gap: 10px;
}

.room-input {
  flex: 1;
  height: 44px;
  background: #F9F9F9;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 18px;
  border: 1px solid #EEEEEE;
  text-align: center;
  letter-spacing: 6px;
}

.room-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 12px 0;
}

.room-id-label {
  font-size: 13px;
  color: #999999;
}

.room-id-value {
  font-size: 28px;
  font-weight: 800;
  color: #FF94B4;
  letter-spacing: 6px;
}

.room-status {
  font-size: 13px;
  color: #999999;
}

.room-share-tip {
  font-size: 12px;
  color: #CCCCCC;
  margin-top: 4px;
}

.btn-leave-room {
  margin-top: 12px;
  background: none;
  border: 1px solid #EEEEEE;
  border-radius: 8px;
  padding: 8px 24px;
  font-size: 12px;
  color: #CCCCCC;
  text-align: center;
}

.btn-leave-room:active {
  background: #F5F5F5;
}

.room-actions { display: flex; gap: 10px; margin-top: 12px; }
.btn-view-sm {
  flex-shrink: 0;
  background: none;
  border: 1px solid #FF94B4;
  border-radius: 8px;
  padding: 6px 16px;
  font-size: 12px;
  color: #FF94B4;
}
.btn-view-sm:active { background: #FFF8FA; }

.joined-room-actions { display: flex; gap: 6px; flex-shrink: 0; }

.joined-room-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid #F0F0F0;
}
.joined-room-item:last-child { border-bottom: none; }
.joined-room-info { display: flex; flex-direction: column; gap: 2px; }
.joined-room-id { font-size: 16px; font-weight: 700; color: #FF94B4; letter-spacing: 2px; }
.joined-room-partner { font-size: 12px; color: #999999; }
.btn-leave-room-sm {
  flex-shrink: 0;
  background: none;
  border: 1px solid #EEEEEE;
  border-radius: 8px;
  padding: 6px 16px;
  font-size: 12px;
  color: #CCCCCC;
}
.btn-leave-room-sm:active { background: #F5F5F5; }

.partner-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 0;
}

.partner-avatar {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, #FFB5C2, #FF94B4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
}

.partner-info { display: flex; flex-direction: column; gap: 2px; }
.partner-name { font-size: 15px; font-weight: 600; color: #333333; }
.partner-status { font-size: 12px; color: #52C41A; }