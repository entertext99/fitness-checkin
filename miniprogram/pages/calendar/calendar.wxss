.calendar-container { padding-bottom: 20px; }
.calendar-header { text-align: center; }

.month-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.nav-btn { font-size: 28px; color: #FF94B4; padding: 4px 16px; font-weight: 300; }
.month-title { font-size: 16px; font-weight: 700; color: #333333; }

.weekday-row { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 8px; }
.weekday { font-size: 12px; color: #999999; text-align: center; padding: 4px 0; }

.days-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.day-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  position: relative;
  padding: 2px;
}
.day-cell.empty { visibility: hidden; }
.day-num { font-size: 12px; color: #333333; font-weight: 500; }
.day-cell.today { border: 1.5px solid #FF94B4; }
.day-cell.today .day-num { color: #FF94B4; font-weight: 700; }

.day-weight { font-size: 9px; color: #FF94B4; font-weight: 600; line-height: 1; margin-top: 1px; }
.day-workout-icon { font-size: 10px; line-height: 1; margin-top: 1px; }

.day-detail { margin-top: 10px; }
.detail-header { font-size: 14px; font-weight: 700; color: #333333; margin-bottom: 12px; text-align: center; }

.detail-section { margin-bottom: 14px; }
.detail-section-title { font-size: 13px; font-weight: 600; color: #666666; display: block; margin-bottom: 8px; }
.detail-record { padding: 10px; background: #FFF8FA; border-radius: 12px; margin-bottom: 8px; }
.record-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.record-time { font-size: 12px; color: #666666; font-weight: 500; }
.record-duration { font-size: 12px; color: #FF94B4; font-weight: 600; }
.record-bottom { display: flex; flex-wrap: wrap; gap: 4px; }

.detail-value { font-size: 14px; color: #333333; font-weight: 600; display: block; }
.detail-value.diet-healthy { color: #52C41A; }
.detail-value.diet-warn { color: #F5222D; }

.detail-measure-row { display: flex; flex-wrap: wrap; gap: 8px; }
.detail-measure-item { font-size: 13px; color: #333333; background: #F9F9F9; padding: 4px 12px; border-radius: 8px; }

.stats-summary { margin-top: 10px; }
.stats-grid { display: flex; gap: 12px; margin-top: 8px; }
.stats-box { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 12px; background: #FFF8FA; border-radius: 12px; }
.stats-num { font-size: 20px; font-weight: 700; color: #FF94B4; }
.stats-label { font-size: 11px; color: #999999; margin-top: 4px; }

.stats-breakdown {
  display: flex;
  gap: 10px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #EEEEEE;
}

.breakdown-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8px;
  background: #F9F9F9;
  border-radius: 8px;
}

.breakdown-lbl {
  font-size: 11px;
  color: #999999;
  margin-bottom: 4px;
}

.breakdown-val {
  font-size: 14px;
  font-weight: 700;
  color: #333333;
}