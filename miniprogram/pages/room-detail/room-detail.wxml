<view class="room-detail-page">
  <view class="card">
    <text class="section-title">🏠 房间 {{roomId}}</text>
    <view class="member-list">
      <view class="member-item" wx:for="{{members}}" wx:key="openid">
        <view class="member-avatar"><text>{{index === 0 ? '👑' : '💪'}}</text></view>
        <view class="member-info">
          <text class="member-name">{{item.nickname}}</text>
          <text class="member-meta">
            {{item.gender ? item.gender + ' · ' : ''}}{{item.height ? item.height + 'cm' : ''}}
            <text wx:if="{{index === 0}}"> · 房主</text>
          </text>
        </view>
        <text class="member-weight" wx:if="{{item.weights.length > 0}}">
          {{item.weights[item.weights.length - 1].weight}}kg
        </text>
      </view>
    </view>
  </view>

  <view wx:if="{{members.length >= 2 && members[0].weights.length >= 2}}" class="card">
    <text class="section-title">📈 体重变化趋势</text>
    <canvas class="chart-canvas" canvas-id="weightChart"></canvas>
  </view>
  <view wx:elif="{{members.length >= 2}}" class="card">
    <text class="section-title">📈 体重变化趋势</text>
    <text class="empty-hint">成员数据不足，暂无法生成趋势图</text>
  </view>

  <view wx:if="{{members.length >= 2 && members[0].measures.length >= 2}}" class="card" wx:for="{{measureFields}}" wx:key="name">
    <text class="section-title">{{item.label}}变化趋势</text>
    <canvas class="chart-canvas-sm" canvas-id="measure_{{item.name}}"></canvas>
  </view>
  <view wx:elif="{{members.length >= 2}}" class="card">
    <text class="section-title">📏 围度变化趋势</text>
    <text class="empty-hint">成员数据不足，暂无法生成趋势图</text>
  </view>
</view>
