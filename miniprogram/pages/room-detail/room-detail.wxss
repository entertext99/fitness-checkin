.room-detail-page { padding-bottom: 20px; }

.member-list { display: flex; flex-direction: column; gap: 10px; margin-top: 8px; }
.member-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background: #FFF8FA;
  border-radius: 12px;
}
.member-avatar {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, #FFB5C2, #FF94B4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}
.member-info { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.member-name { font-size: 15px; font-weight: 600; color: #333333; }
.member-meta { font-size: 12px; color: #999999; }
.member-weight { font-size: 14px; font-weight: 700; color: #FF94B4; }

.chart-canvas { width: 100%; height: 180px; margin-top: 8px; }
.chart-canvas-sm { width: 100%; height: 150px; margin-top: 8px; }
.empty-hint { font-size: 13px; color: #CCCCCC; text-align: center; padding: 20px 0; display: block; }
